<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Projeto_Gerenciamento_usuarios_wpf.AdminCadastro"
        mc:Ignorable="d"
        Title="AdminCadastro" Height="450" Width="800">
    <Grid Background="#FFA299D1">
        <Label Content="Register--ADMIN" HorizontalAlignment="Center" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="36" Foreground="#FFFFFEFE" Margin="0,10,0,0"/>
        <Label Content="Full name" HorizontalAlignment="Center" Margin="0,65,0,0" VerticalAlignment="Top" Foreground="White" FontSize="16" FontFamily="Arial Black" RenderTransformOrigin="0.671,0.626"/>

        <ui:TextBox HorizontalAlignment="Center" Margin="0,92,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32"/>
        <Label Content="Email" HorizontalAlignment="Center" Margin="0,129,0,0" VerticalAlignment="Top" Foreground="#FFFDFDFD" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox HorizontalAlignment="Center" Margin="0,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32" Text=""/>
        <Label Content="Password" HorizontalAlignment="Center" Height="21" Margin="0,260,0,0" VerticalAlignment="Top" Width="88" Foreground="White" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox HorizontalAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32" Margin="0,286,0,0"/>
        <Label Content="Username" HorizontalAlignment="Center" Margin="0,195,0,0" VerticalAlignment="Top" Foreground="#FFFFFEFE" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32"/>
        <ui:Button Content="Register" Margin="0,361,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" FontFamily="Arial Black" Height="35" Width="128"/>

    </Grid>
</Window>
