<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.AdminCadastro"
         WindowStartupLocation="CenterScreen"
        mc:Ignorable="d"
        Title="AdminCadastro" Height="600" Width="800">

    <Grid Background="#FFA299D1">

        <Label Content="Register--ADMIN"
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="36"
               Foreground="#FFFFFEFE"
               Margin="0,10,0,0"/>

        <Label Content="Full name"
               HorizontalAlignment="Center"
               Margin="0,65,0,0"
               VerticalAlignment="Top"
               Foreground="White"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox
            x:Name="TxtNome"
            HorizontalAlignment="Center"
            Margin="0,87,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Width="188"
            Height="37"/>

        <Label Content="Email"
               HorizontalAlignment="Center"
               Margin="0,129,0,0"
               VerticalAlignment="Top"
               Foreground="#FFFDFDFD"
               FontFamily="Arial Black"
               FontSize="16"/>

        <ui:TextBox
            x:Name="TxtEmail"
            HorizontalAlignment="Center"
            Margin="0,151,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Width="188"
            Height="39"/>

        <Label Content="Username"
               HorizontalAlignment="Center"
               Margin="0,195,0,0"
               VerticalAlignment="Top"
               Foreground="#FFFFFEFE"
               FontFamily="Arial Black"
               FontSize="16"/>

        <ui:TextBox
            x:Name="TxtUsername"
            HorizontalAlignment="Center"
            Margin="0,217,0,0"
            TextWrapping="Wrap"
            VerticalAlignment="Top"
            Width="188"
            Height="38"/>

        <Label Content="Password"
               HorizontalAlignment="Center"
               Height="21"
               Margin="0,260,0,0"
               VerticalAlignment="Top"
               Width="88"
               Foreground="White"
               FontFamily="Arial Black"
               FontSize="16"/>

        <ui:PasswordBox
            x:Name="TxtPassword"
            HorizontalAlignment="Center"
            Margin="0,282,0,0"
            VerticalAlignment="Top"
            Width="377"/>

        <Label Content="Confirm Password"
               HorizontalAlignment="Center"
               Margin="0,323,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="16"/>

        <ui:PasswordBox
            x:Name="TxtConfirmPassword"
            HorizontalAlignment="Center"
            Margin="0,345,0,0"
            VerticalAlignment="Top"
            Width="410"/>


        <!-- AVATAR DO ADMIN -->

        <Label Content="Choose your Avatar"
               HorizontalAlignment="Center"
               Margin="0,395,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="16"
               Foreground="White"/>

        <Button
    Width="70"
    Height="70"
    Margin="0,425,0,0"
    VerticalAlignment="Top"
    HorizontalAlignment="Center"
    Padding="0">

            <Button.Style>
                <Style TargetType="Button">
                    <Style.Triggers>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>

            <Image
        Source="/Imagens/adminAvatar.jpg"
        Stretch="UniformToFill"/>
        </Button>


        <ui:Button
            Content="Register"
            Click="BtnRegister_Click"
            Margin="0,515,0,0"
            VerticalAlignment="Top"
            HorizontalAlignment="Center"
            FontFamily="Arial Black"
            Height="35"
            Width="128"/>

    </Grid>
</Window>
