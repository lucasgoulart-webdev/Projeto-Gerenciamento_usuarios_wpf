<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
         WindowStartupLocation="CenterScreen"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.Create"
        mc:Ignorable="d"
        Title="Create"
        Height="500"
        Width="800">

    <Grid Background="#FFC199D1">

        <!-- Título -->
        <Label Content="Create new Account"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"
               VerticalAlignment="Top"
               Foreground="#FFFAF6F6"
               FontFamily="Arial Black"
               FontSize="24"/>

        <!-- COLUNA ESQUERDA -->

        <Label Content="Full Name"
               HorizontalAlignment="Left"
               Margin="125,65,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox
                    x:Name="TxtNome"
                    HorizontalAlignment="Left"
                    Margin="100,90,0,0"
                    VerticalAlignment="Top"
                    Width="188"
                    Height="37"/>


        <Label Content="Username"
               HorizontalAlignment="Left"
               Margin="125,140,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox
                    x:Name="TxtUsername"
                    HorizontalAlignment="Left"
                    Margin="100,165,0,0"
                    VerticalAlignment="Top"
                    Width="188"
                    Height="37"/>


        <Label Content="Password"
               HorizontalAlignment="Left"
               Margin="125,215,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:PasswordBox
                        x:Name="TxtPassword"
                        HorizontalAlignment="Left"
                        Margin="100,240,0,0"
                        VerticalAlignment="Top"
                        Width="188"
                        Height="37"/>


        <!-- COLUNA DIREITA -->

        <Label Content="Email"
               HorizontalAlignment="Left"
               Margin="535,65,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox
                    x:Name="TxtEmail"
                    HorizontalAlignment="Left"
                    Margin="469,90,0,0"
                    VerticalAlignment="Top"
                    Width="188"
                    Height="37"/>


        <Label Content="Confirm Password"
               HorizontalAlignment="Left"
               Margin="483,140,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:PasswordBox
                        x:Name="TxtConfirmPassword"
                        HorizontalAlignment="Left"
                        Margin="469,165,0,0"
                        VerticalAlignment="Top"
                        Width="188"
                        Height="37"/>
        
        


        <!-- AVATARES -->

        <Label Content="Choose your Avatar"
               HorizontalAlignment="Center"
               Margin="0,300,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <WrapPanel HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,330,0,0">

            <Button  x:Name="Avatar1" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar1_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar1.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar2" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar2_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image Source="/Imagens/avatar2.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar3" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar3_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar3.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar4" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar4_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar4.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar5" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar5_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar5.jpg" Stretch="Uniform"/>
            </Button>

        </WrapPanel>


        <!-- BOTÃO CREATE -->

        <ui:Button Content="Create"
                   Click="BtnCreate_Click"
                   Margin="0,420,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Height="35"
                   FontFamily="Arial Black"
                   Width="128"/>


        <ComboBox
        x:Name="ComboPerfil"
        HorizontalAlignment="Left"
        Margin="494,235,0,0"
        VerticalAlignment="Top"
        Width="130"
        Height="38">

          
            <ComboBoxItem Content="Usuário"/>
            <ComboBoxItem Content="Administrador"/>

        </ComboBox>
        <Label Content="Acess level" HorizontalAlignment="Left" Margin="510,213,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black"/>
        <ui:Button Content="Back" Margin="18,442,0,0" VerticalAlignment="Top" Width="149" FontFamily="Arial Black" Click="Button_Click"/>

    </Grid>

</Window>
