<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Projeto_Gerenciamento_usuarios_wpf.Create"
        mc:Ignorable="d"
        Title="Create" Height="450" Width="800">
    <Grid Background="#FFC199D1">
        <Label Content="Create user Account" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Foreground="#FFFAF6F6" FontFamily="Arial Black" FontSize="24"/>
        <Label Content="Full Name" HorizontalAlignment="Center" Margin="0,60,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black"/>

        <ui:TextBox HorizontalAlignment="Center" Margin="0,87,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32"/>
        <Label Content="Email" HorizontalAlignment="Center" Margin="0,124,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox HorizontalAlignment="Center" Margin="0,151,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32"/>
        <Label Content="Username" HorizontalAlignment="Center" Margin="0,188,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black"/>
        <ui:TextBox HorizontalAlignment="Center" Margin="0,215,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32"/>
        <Label Content="Password" HorizontalAlignment="Center" Margin="0,252,0,0" VerticalAlignment="Top" FontSize="16" FontFamily="Arial Black"/>
        <ui:TextBox HorizontalAlignment="Center" Margin="0,274,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="188" Height="32"/>
        <ui:Button Content="Create" Margin="0,360,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Height="35" Width="128"/>

    </Grid>
</Window>
