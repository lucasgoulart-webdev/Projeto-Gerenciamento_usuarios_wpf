<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.Create"
        mc:Ignorable="d"
        Title="Create"
        Height="500"
        Width="800">

    <Grid Background="#FFC199D1">

        <!-- Título -->
        <Label Content="Create user Account"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"
               VerticalAlignment="Top"
               Foreground="#FFFAF6F6"
               FontFamily="Arial Black"
               FontSize="24"/>

        <!-- COLUNA ESQUERDA -->

        <Label Content="Full Name"
               HorizontalAlignment="Left"
               Margin="125,65,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox HorizontalAlignment="Left"
                    Margin="100,90,0,0"
                    VerticalAlignment="Top"
                    Width="188"
                    Height="37"/>


        <Label Content="Username"
               HorizontalAlignment="Left"
               Margin="125,140,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox HorizontalAlignment="Left"
                    Margin="100,165,0,0"
                    VerticalAlignment="Top"
                    Width="188"
                    Height="37"/>


        <Label Content="Password"
               HorizontalAlignment="Left"
               Margin="125,215,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:PasswordBox HorizontalAlignment="Left"
                        Margin="100,240,0,0"
                        VerticalAlignment="Top"
                        Width="188"
                        Height="37"/>


        <!-- COLUNA DIREITA -->

        <Label Content="Email"
               HorizontalAlignment="Left"
               Margin="475,65,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:TextBox HorizontalAlignment="Left"
                    Margin="450,90,0,0"
                    VerticalAlignment="Top"
                    Width="188"
                    Height="37"/>


        <Label Content="Confirm Password"
               HorizontalAlignment="Left"
               Margin="425,140,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <ui:PasswordBox HorizontalAlignment="Left"
                        Margin="450,165,0,0"
                        VerticalAlignment="Top"
                        Width="188"
                        Height="37"/>


        <!-- AVATARES -->

        <Label Content="Choose your Avatar"
               HorizontalAlignment="Center"
               Margin="0,300,0,0"
               VerticalAlignment="Top"
               FontSize="16"
               FontFamily="Arial Black"/>

        <WrapPanel HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,330,0,0">

            <Button Width="60"
                    Height="60"
                    Margin="5"
                    Padding="0"
                    Click="Avatar1_Click">

                <Image Source="Images/avatar1.png"
                       Stretch="Uniform"/>
            </Button>

            <Button Width="60"
                    Height="60"
                    Margin="5"
                    Padding="0"
                    Click="Avatar2_Click">

                <Image Source="Images/avatar2.png"
                       Stretch="Uniform"/>
            </Button>

            <Button Width="60"
                    Height="60"
                    Margin="5"
                    Padding="0"
                    Click="Avatar3_Click">

                <Image Source="Images/avatar3.png"
                       Stretch="Uniform"/>
            </Button>

            <Button Width="60"
                    Height="60"
                    Margin="5"
                    Padding="0"
                    Click="Avatar4_Click">

                <Image Source="Images/avatar4.png"
                       Stretch="Uniform"/>
            </Button>

            <Button Width="60"
                    Height="60"
                    Margin="5"
                    Padding="0"
                    Click="Avatar5_Click">

                <Image Source="Images/avatar5.png"
                       Stretch="Uniform"/>
            </Button>

        </WrapPanel>


        <!-- BOTÃO CREATE -->

        <ui:Button Content="Create"
                   Margin="0,420,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Height="35"
                   Width="128"/>

    </Grid>

</Window>
