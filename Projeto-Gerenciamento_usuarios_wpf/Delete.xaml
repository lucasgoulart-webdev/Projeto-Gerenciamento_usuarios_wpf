<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        WindowStartupLocation="CenterScreen"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.Delete"
        mc:Ignorable="d"
        Title="Delete"
        Height="500"
        Width="800">

    <Grid Background="#FFB799D1">

        <!-- TÍTULO -->

        <Label Content="Delete User"
               HorizontalAlignment="Center"
               Margin="0,15,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="36"
               Foreground="White"/>


        <!-- DESCRIÇÃO -->

        <Label Content="Write the email of the user you want to delete"
               HorizontalAlignment="Center"
               Margin="0,75,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="16"
               Foreground="White"/>


        <!-- CAMPO DE E-MAIL -->

        <ui:TextBox
               x:Name="TxtEmail"
               HorizontalAlignment="Center"
               Margin="0,125,0,0"
               VerticalAlignment="Top"
               Width="300"
               Height="38"/>


        <!-- BOTÃO DELETE -->

        <ui:Button
               Content="Delete"
               Click="BtnDelete_Click"
               HorizontalAlignment="Center"
               Margin="0,185,0,0"
               VerticalAlignment="Top"
               Width="180"
               Height="38"
               FontFamily="Arial Black"/>


        <!-- ÁREA DE REGRAS -->

        <Border
               HorizontalAlignment="Center"
               VerticalAlignment="Top"
               Margin="0,255,0,0"
               Width="650"
               Height="145"
               Background="#22FFFFFF"
               CornerRadius="12"
               BorderBrush="#55FFFFFF"
               BorderThickness="1">

            <StackPanel
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <TextBlock
                        Text="Deletion Rules"
                        HorizontalAlignment="Center"
                        FontFamily="Arial Black"
                        FontSize="17"
                        Foreground="White"
                        Margin="0,0,0,10"/>

                <TextBlock
                        Text="• Only administrators can delete users."
                        FontSize="14"
                        Foreground="White"
                        Margin="0,3"/>

                <TextBlock
                        Text="• An administrator cannot delete their own account."
                        FontSize="14"
                        Foreground="White"
                        Margin="0,3"/>

                <TextBlock
                        Text="• The last administrator cannot be deleted."
                        FontSize="14"
                        Foreground="White"
                        Margin="0,3"/>

                <TextBlock
                        Text="• A confirmation is required before deletion."
                        FontSize="14"
                        Foreground="White"
                        Margin="0,3"/>

            </StackPanel>

        </Border>
        <ui:Button Content="Back" Margin="0,442,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Click="Button_Click" Width="116" FontFamily="Arial Black"/>

    </Grid>

</Window>
