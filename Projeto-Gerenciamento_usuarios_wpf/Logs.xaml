<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Projeto_Gerenciamento_usuarios_wpf.Logs"
        mc:Ignorable="d"
        Title="Logs" Height="450" Width="800">
    <Grid Background="#FFBC99D1">
        <Label Content="Logs" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="36"/>

        <ui:DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="0,55,0,71"/>
        <ui:Button Content="Back" Margin="0,375,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="132"/>

    </Grid>
</Window>
