<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.Logs"
        mc:Ignorable="d"
        Title="Logs"
        Height="600"
        Width="1000">

    <Grid Background="#FFBC99D1">

        <!-- TÍTULO -->

        <Label Content="Audit Logs"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="32"
               Foreground="White"/>


        <!-- PESQUISA -->

        <ui:TextBox
               x:Name="TxtPesquisa"
               HorizontalAlignment="Left"
               Margin="35,65,0,0"
               VerticalAlignment="Top"
               Width="260"
               Height="36"/>

        <ui:Button
               x:Name="BtnSearch"
               Content="Search"
               Click="BtnSearch_Click"
               HorizontalAlignment="Left"
               Margin="305,65,0,0"
               VerticalAlignment="Top"
               Width="100"
               Height="36"/>


        <!-- FILTRO DE OPERAÇÃO -->

        <Label Content="Operation"
               HorizontalAlignment="Left"
               Margin="435,43,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               Foreground="White"/>

        <ComboBox
               x:Name="CmbOperacao"
               HorizontalAlignment="Left"
               Margin="435,65,0,0"
               VerticalAlignment="Top"
               Width="145"
               Height="36">

            <ComboBoxItem Content="Todas"/>
            <ComboBoxItem Content="Cadastro"/>
            <ComboBoxItem Content="Alteração"/>
            <ComboBoxItem Content="Alteração de perfil"/>
            <ComboBoxItem Content="Alteração de permissões"/>
            <ComboBoxItem Content="Ativação"/>
            <ComboBoxItem Content="Desativação"/>
            <ComboBoxItem Content="Exclusão"/>
            <ComboBoxItem Content="Redefinição de senha"/>
            <ComboBoxItem Content="Alteração de imagem"/>

        </ComboBox>


        <!-- TABELA DE AUDITORIA -->

        <DataGrid
               x:Name="GridLogs"
               Margin="25,125,25,70"
               AutoGenerateColumns="False"
               IsReadOnly="True"
               CanUserAddRows="False"
               CanUserDeleteRows="False"
               HeadersVisibility="Column"
               GridLinesVisibility="Horizontal"
               SelectionMode="Single">

            <!-- DATA E HORA -->

            <DataGridTextColumn
                    Header="Date / Time"
                    Binding="{Binding DataHora}"
                    Width="150"/>


            <!-- RESPONSÁVEL -->

            <DataGridTextColumn
                    Header="Responsible User"
                    Binding="{Binding UsuarioResponsavel}"
                    Width="150"/>


            <!-- OPERAÇÃO -->

            <DataGridTextColumn
                    Header="Operation"
                    Binding="{Binding Operacao}"
                    Width="150"/>


            <!-- REGISTRO AFETADO -->

            <DataGridTextColumn
                    Header="Affected Record"
                    Binding="{Binding RegistroAfetado}"
                    Width="150"/>


            <!-- VALOR ANTERIOR -->

            <DataGridTextColumn
                    Header="Previous Value"
                    Binding="{Binding ValorAnterior}"
                    Width="180"/>


            <!-- NOVO VALOR -->

            <DataGridTextColumn
                    Header="New Value"
                    Binding="{Binding NovoValor}"
                    Width="180"/>

        </DataGrid>


        <!-- BOTÃO VOLTAR -->

        <ui:Button
               x:Name="BtnBack"
               Content="Back"
               Click="BtnBack_Click"
               HorizontalAlignment="Center"
               Margin="0,550,0,0"
               VerticalAlignment="Top"
               Width="132"
               Height="36"/>

    </Grid>

</Window>
