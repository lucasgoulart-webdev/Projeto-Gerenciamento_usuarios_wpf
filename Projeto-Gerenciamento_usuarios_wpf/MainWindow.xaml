<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Class="Projeto_Gerenciamento_usuarios_wpf.MainWindow"
    mc:Ignorable="d"
    Title="MainWindow"
    Height="450"
    Width="800">

    <Grid Background="#FFAC94ED">

        <!-- TÍTULO -->

        <Label
            Content="HUB"
            HorizontalAlignment="Center"
            Margin="0,-12,0,0"
            VerticalAlignment="Top"
            Height="105"
            Width="128"
            FontFamily="Impact"
            FontSize="72"/>


        <!-- MENSAGEM -->

        <Label x:Name="txtInicial"
            Content="Hello USER_NAME, Welcome!"
            HorizontalAlignment="Left"
            Margin="108,98,0,0"
            VerticalAlignment="Top"
            FontSize="16"
            FontFamily="Segoe UI Variable Small Semibold"/>


        <!-- CARD DO USUÁRIO -->

        <Border
            Width="330"
            Height="245"
            Background="White"
            CornerRadius="15"
            HorizontalAlignment="Left"
            VerticalAlignment="Top"
            Margin="40,145,0,0">

            <StackPanel
                HorizontalAlignment="Center"
                VerticalAlignment="Center">

                <!-- AVATAR -->

                <Border
                    Width="80"
                    Height="80"
                    CornerRadius="40"
                    Margin="0,5,0,10">

                    <Image x:Name="imagem"
                        Source="Images/avatar1.png"
                        Stretch="UniformToFill"/>

                </Border>


                <!-- NOME -->

                <TextBlock x:Name="Nome_completo"
                    Text="USER NAME"
                    FontSize="18"
                    FontWeight="Bold"
                    HorizontalAlignment="Center"
                    Foreground="#333333"/>


                <!-- NOME DE USUÁRIO -->

                <TextBlock 
                    x:Name="username"
                    
                    FontSize="14"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0"
                    Foreground="#666666"/>


                <!-- TIPO DE USUÁRIO -->

                <TextBlock x:Name="tipoUser"
                    
                    Text="Tipo de usuário: Usuário"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Margin="0,5,0,0"
                    Foreground="#555555"/>


                <!-- NÍVEL / PERFIL -->

                <TextBlock x:Name="email"
                    Text="EMAIL"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Margin="0,3,0,0"
                    Foreground="#555555"/>


                <!-- ÚLTIMO LOGIN -->

                <TextBlock x:Name="lastLogin"
                    Text="Último login: 27/09/2026"
                    FontSize="13"
                    HorizontalAlignment="Center"
                    Margin="0,3,0,0"
                    Foreground="#555555"/>

            </StackPanel>

        </Border>


        <!-- OPÇÃO DO USUÁRIO -->

        <ui:Button
            Content="See users"
            Margin="565,287,0,0"
            VerticalAlignment="Top"
            Height="64"
            Width="150" Click="Button_Click"/>
        <ui:Button Content="Edit Profile" Margin="565,204,0,0" VerticalAlignment="Top" Width="150" Height="64" Click="Button_Click_1"/>
        <ui:Button Content="Change Password" Margin="565,124,0,0" VerticalAlignment="Top" Width="150" Height="62" Click="Button_Click_2"/>

    </Grid>

</Window>
