<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.Read"
        mc:Ignorable="d"
        Title="Users"
        Height="650"
        Width="1000">

    <Grid Background="#FFB299D1">

        <!-- TÍTULO -->

        <Label Content="Users"
               HorizontalAlignment="Center"
               Margin="0,10,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="28"
               Foreground="White"/>


        <!-- ÁREA DE PESQUISA -->

        <ui:TextBox
               x:Name="TxtPesquisa"
               HorizontalAlignment="Left"
               Margin="40,65,0,0"
               VerticalAlignment="Top"
               Width="300"
               Height="38"/>

        <ui:Button
               Content="Search"
               x:Name="BtnSearch"
               Click="BtnSearch_Click"
               HorizontalAlignment="Left"
               Margin="350,65,0,0"
               VerticalAlignment="Top"
               Width="110"
               Height="38"/>


        <!-- FILTRO DE PERFIL -->

        <Label Content="Profile"
               HorizontalAlignment="Left"
               Margin="500,43,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               Foreground="White"/>

        <ComboBox
               x:Name="CmbPerfil"
               HorizontalAlignment="Left"
               Margin="500,65,0,0"
               VerticalAlignment="Top"
               Width="130"
               Height="38">

            <ComboBoxItem Content="Todos"/>
            <ComboBoxItem Content="Usuário"/>
            <ComboBoxItem Content="Administrador"/>

        </ComboBox>


        <!-- FILTRO DE STATUS -->

        <Label Content="Status"
               HorizontalAlignment="Left"
               Margin="650,43,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               Foreground="White"/>

        <ComboBox
               x:Name="CmbStatus"
               HorizontalAlignment="Left"
               Margin="650,65,0,0"
               VerticalAlignment="Top"
               Width="130"
               Height="38">

            <ComboBoxItem Content="Todos"/>
            <ComboBoxItem Content="Ativo"/>
            <ComboBoxItem Content="Bloqueado"/>

        </ComboBox>


        <!-- LISTA DE USUÁRIOS -->

        <ScrollViewer
               HorizontalScrollBarVisibility="Disabled"
               VerticalScrollBarVisibility="Auto"
               Margin="30,125,30,70">

            <WrapPanel
                   x:Name="UsersPanel"
                   HorizontalAlignment="Center">

                <!--
                    Os cards dos usuários serão criados
                    automaticamente pelo C#.
                -->

            </WrapPanel>

        </ScrollViewer>


        <!-- BOTÃO BACK -->

        <ui:Button
               Content="Back"
               Click="BtnBack_Click"
               HorizontalAlignment="Center"
               Margin="0,585,0,0"
               VerticalAlignment="Top"
               Height="37"
               Width="128"/>

    </Grid>

</Window>
