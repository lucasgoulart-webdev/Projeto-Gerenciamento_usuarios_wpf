        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" x:Class="Projeto_Gerenciamento_usuarios_wpf.Read"
        mc:Ignorable="d"
        Title="Read" Height="450" Width="800">
    <Grid Background="#FFB299D1">
        <Label Content="Logs" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" RenderTransformOrigin="-0.721,0.51" FontFamily="Arial Black" FontSize="24"/>

        <ui:DataGrid d:ItemsSource="{d:SampleData ItemCount=5}" Margin="32,47,32,135"/>
        <ui:AutoSuggestBox/>
        <ui:Button Content="Back" Margin="0,373,0,0" VerticalAlignment="Top" Height="37" Width="128" HorizontalAlignment="Center"/>

    </Grid>
</Window>
