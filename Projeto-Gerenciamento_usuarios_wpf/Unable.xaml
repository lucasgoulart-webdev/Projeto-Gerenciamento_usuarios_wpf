<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.Unable"
        mc:Ignorable="d"
        Title="Unable"
        Height="450"
        Width="800">

    <Grid Background="#FFA599D1">

        <Label Content="Unable user"
               HorizontalAlignment="Center"
               Margin="0,19,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="36"/>

        <Label Content="Write email of who do you want to block"
               HorizontalAlignment="Center"
               Margin="0,110,0,0"
               VerticalAlignment="Top"
               FontFamily="Arial Black"
               FontSize="16"/>

        <ui:TextBox x:Name="TxtEmail"
                    HorizontalAlignment="Center"
                    TextWrapping="Wrap"
                    VerticalAlignment="Top"
                    Width="277"
                    Height="38"
                    Margin="0,156,0,0"/>

        <ui:Button Content="Search"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Top"
                   Margin="0,210,0,0"
                   Width="120"
                   Height="35"/>

        <ComboBox x:Name="CmbStatus"
                  HorizontalAlignment="Center"
                  Margin="0,271,0,0"
                  VerticalAlignment="Top"
                  Width="168"
                  Height="35">

            <ComboBoxItem Content="Block user"/>
            <ComboBoxItem Content="Activate user"/>

        </ComboBox>

        <ui:Button Content="Set"
                   Margin="0,358,0,0"
                   VerticalAlignment="Top"
                   HorizontalAlignment="Center"
                   Width="168"
                   Height="35"/>

    </Grid>
</Window>
