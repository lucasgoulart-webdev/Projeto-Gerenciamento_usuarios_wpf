<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Projeto_Gerenciamento_usuarios_wpf"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" 
         WindowStartupLocation="CenterScreen"
        x:Class="Projeto_Gerenciamento_usuarios_wpf.editarPerfil"
        mc:Ignorable="d"
        Title="editarPerfil" Height="450" Width="800">
    <Grid Background="#FFAA99D1">

        <ui:Button Content="Button" Margin="1299,250,0,0" VerticalAlignment="Top" Width="0"/>
        <Label Content="Edit Profile" HorizontalAlignment="Center" Margin="0,10,0,0" VerticalAlignment="Top" Width="224" FontFamily="Arial Black" FontSize="36"/>
        <Label Content="Name" HorizontalAlignment="Center" Margin="0,60,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox x:Name="name" HorizontalAlignment="Center" Margin="0,87,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Username" HorizontalAlignment="Center" Margin="0,128,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox x:Name="username" HorizontalAlignment="Center" Margin="0,150,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Email" HorizontalAlignment="Center" Margin="0,190,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="16"/>
        <ui:TextBox x:Name="email" HorizontalAlignment="Center" Margin="0,217,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>
        <Label Content="Avatar" HorizontalAlignment="Center" Margin="0,259,0,0" VerticalAlignment="Top" FontFamily="Arial Black" FontSize="16"/>
        <WrapPanel Margin="224,286,224,77">



            <Button  x:Name="Avatar1" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar1_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar1.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar2" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar2_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image Source="/Imagens/avatar2.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar3" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar3_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar3.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar4" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar4_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar4.jpg" Stretch="Uniform"/>
            </Button>

            <Button x:Name="Avatar5" Width="60" Height="60" Margin="5" Padding="0" Click="Avatar5_Click">
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
                <Image  Source="/Imagens/avatar5.jpg" Stretch="Uniform"/>
            </Button>

        </WrapPanel>
        <ui:Button Content="Set" Margin="0,373,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Width="201" Click="Button_Click"/>

    </Grid>
</Window>
